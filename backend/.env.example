# =============================================
# PADEL RANKING APP — Variables de entorno
# =============================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor
PORT=3000

# ─── JWT ──────────────────────────────────
# Secreto para firmar los tokens JWT (mín. 32 caracteres, usar valor aleatorio seguro en producción)
JWT_SECRET=changeme_use_a_long_random_secret_in_production

# Tiempo de expiración del token JWT (ej: 1h, 7d, 30d)
JWT_EXPIRATION=8h

# Tiempo de expiración del token de setup de contraseña (ej: 24h, 48h)
JWT_SETUP_EXPIRATION=48h

# ─── Base de datos ────────────────────────
# En desarrollo se usa SQLite en memoria (dejar vacío o :memory:)
# En producción: postgresql://user:pass@host:5432/dbname
DATABASE_URL=:memory:

# ─── Email ────────────────────────────────
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Padel Ranking <noreply@padelranking.local>

# ─── URLs ─────────────────────────────────
FRONTEND_URL=http://localhost:4200

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ─── Rate Limiting ────────────────────────
# Máximo de intentos de login por IP en la ventana de tiempo
RATE_LIMIT_AUTH_MAX=10
# Ventana de tiempo en minutos
RATE_LIMIT_AUTH_WINDOW_MIN=15
